# Descope (backend). For local development, copy this file to
# functions/.env.local (gitignored; loaded by the Functions emulator) and set:
#   DESCOPE_PROJECT_ID=<same real development Descope Project ID as the
#                      frontend VITE_DESCOPE_PROJECT_ID>
# It is the expected audience for session-token validation, so it must match
# the Descope project the frontend signs users in with.
#
# Do not use functions/.env or functions/.env.<project> for real values: they
# are NOT gitignored. Never prefix this with VITE_. Real secrets (e.g. a
# Descope management key) must use defineSecret() / Cloud Secret Manager.
DESCOPE_PROJECT_ID=

# Razorpay (backend, Test Mode only for now). RAZORPAY_KEY_ID is public (the
# Checkout key_id) and follows DESCOPE_PROJECT_ID's rule above: copy this to
# functions/.env.local for local development, never functions/.env or
# functions/.env.<project>.
RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET is a REAL secret (declared with defineSecret() in
# providers/razorpay.ts, matching Cloud Secret Manager in production). It
# does NOT belong in this file or in functions/.env.local. For local
# emulator development, put it in functions/.secret.local instead (also
# gitignored by the existing *.local rule) as:
#   RAZORPAY_KEY_SECRET=<your Razorpay Test Mode key_secret>
# Never commit a real key_secret anywhere.
