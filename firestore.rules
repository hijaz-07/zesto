rules_version = '2';

// ===============================================================
// Access architecture
// ===============================================================
//
// Descope is Zesto's sole identity provider. Firebase Authentication is
// NOT used, so `request.auth` never carries a Zesto identity: for every
// legitimate Zesto client it is null. Any non-null `request.auth` would
// come from a Firebase Auth sign-in outside of Zesto, which must never
// be treated as a Zesto user. These rules therefore grant NOTHING based
// on `request.auth`.
//
// Protected data is accessed only through Cloud Functions, which:
//   1. validate the caller's Descope session token server-side
//      (functions/src/auth/session.ts),
//   2. authorize tenant access from organizations/{organizationId}/
//      members/{userId} (functions/src/auth/membership.ts), and
//   3. read/write Firestore with the Admin SDK (which bypasses these
//      rules) and enforce schema validation there.
//
// Direct client access may be re-opened later ONLY for data that needs no
// identity (e.g. published menus), and must be justified per collection.
// See docs/architecture/authentication.md.
//
// ===============================================================
// Data model (written by trusted backend code only)
// ===============================================================
//
// Collection: users
// Document ID: {userId} — the Descope user ID (session JWT `sub`).
// Fields:
//   - id: string (required, immutable) — must equal the document id.
//   - displayName: string (optional, 1-100 chars)
//   - phoneNumber: string (optional, 1-20 chars)
//   - email: string (optional, valid email format)
//   - createdAt: timestamp (required, immutable)
// A user document holds only that user's own profile info (PII). It has no
// role or organization fields — organization access is granted exclusively
// through the `members` subcollection below, never through this document.
//
// Subcollection: users/{userId}/orderIdempotencyKeys
// Document ID: {idempotencyKey} — the opaque, client-supplied idempotency
// key from a POST /orders request, bounded/validated server-side (see
// functions/src/domain/orders.ts). Fields:
//   - idempotencyKey, userId: string (required, immutable) — must equal the
//     document id / the parent user id respectively.
//   - requestFingerprint: string (required, immutable) — a deterministic
//     digest of the logical order request, used to tell a safe retry (same
//     key, same request) apart from a reused key with a different request.
//   - organizationId, outletId, menuId, orderId: string (required,
//     immutable) — identify the order this key produced.
//   - createdAt: timestamp (required, immutable)
// Exists so order creation can atomically check-and-reserve an idempotency
// key inside one Firestore transaction, the same pattern outletSlugs/
// organizationSlugs use for uniqueness. Nesting under users/{userId} is
// what makes cross-user idempotency-key reuse impossible: only trusted
// backend code, acting on the verified session's own user id, ever reads or
// writes this path. Never read or written directly by clients.
//
// Collection: organizations
// Document ID: {organizationId} — a Firestore auto-ID.
// Fields:
//   - id: string (required, immutable) — must equal the document id.
//   - name: string (required, 1-100 chars)
//   - slug: string (required, immutable for this first implementation) —
//     lowercase letters/digits/hyphens, 3-50 chars, globally unique (see
//     organizationSlugs below).
//   - createdAt: timestamp (required, immutable)
//   - createdBy: string (required, immutable) — the Descope user ID that
//     created the organization. Not necessarily the current owner if
//     ownership is ever transferred (a future requirement) — current
//     ownership is always read from the members subcollection below.
// Provisioned by trusted backend code only.
//
// Collection: organizationSlugs
// Document ID: {slug} — the reserved slug itself.
// Fields:
//   - organizationId: string (required, immutable)
//   - createdAt: timestamp (required, immutable)
// Exists solely so organization creation can atomically check-and-reserve a
// slug inside one Firestore transaction (functions/src/domain/organizations.ts).
// Never read or written directly by clients.
//
// Subcollection: organizations/{organizationId}/members
// Document ID: {memberId} — the member's Descope user ID.
// Fields:
//   - userId: string (required, immutable) — must equal the document id.
//   - organizationId: string (required, immutable) — must equal the parent
//     organization id.
//   - role: string (required) — one of 'owner' | 'manager' | 'staff'.
//     Roles are tenant-scoped; there are no global custom claims.
//   - status: string (required) — one of 'active' | 'invited' | 'revoked'.
//     Only 'active' grants organization access.
//   - createdAt: timestamp (required, immutable)
// Membership is created and changed exclusively by trusted backend code,
// so a user can never grant themselves membership or change a role.
//
// Subcollection: organizations/{organizationId}/outlets
// Document ID: {outletId} — a Firestore auto-ID.
// Fields:
//   - id: string (required, immutable) — must equal the document id.
//   - organizationId: string (required, immutable) — must equal the parent
//     organization id.
//   - name: string (required, 1-100 chars)
//   - slug: string (required, immutable for this first implementation) —
//     lowercase letters/digits/hyphens, 3-50 chars, unique within the parent
//     organization only (see outletSlugs below), NOT globally unique.
//   - description, phone, address, location: optional (see
//     functions/src/domain/outlets.ts for shapes/limits).
//   - status: string (required) — one of 'active' | 'inactive'.
//   - createdAt, updatedAt: timestamp (required)
//   - createdBy: string (required, immutable) — the Descope user ID that
//     created the outlet.
// Provisioned by trusted backend code only.
//
// Subcollection: organizations/{organizationId}/outletSlugs
// Document ID: {slug} — the reserved slug itself, scoped to this organization.
// Fields:
//   - organizationId: string (required, immutable)
//   - outletId: string (required, immutable)
//   - createdAt: timestamp (required, immutable)
// Exists solely so outlet creation can atomically check-and-reserve a
// per-organization-unique slug inside one Firestore transaction
// (functions/src/domain/outlets.ts) — the same pattern organizationSlugs
// uses for global uniqueness. Never read or written directly by clients.
//
// Subcollection: organizations/{organizationId}/outlets/{outletId}/menus
// Document ID: {menuId} — a Firestore auto-ID.
// Fields:
//   - id: string (required, immutable) — must equal the document id.
//   - organizationId: string (required, immutable) — must equal the parent
//     organization id.
//   - outletId: string (required, immutable) — must equal the parent
//     outlet id.
//   - menuDate: string (required) — the food-service calendar date,
//     "YYYY-MM-DD". Zesto's business time zone is Asia/Kolkata (hardcoded
//     for v1; see functions/src/time.ts).
//   - title: string (required, 1-100 chars)
//   - description: string (optional, 0-500 chars)
//   - status: string (required) — one of 'draft' | 'published' | 'archived'.
//     Only 'draft' -> 'published' -> 'archived' transitions are allowed,
//     each an explicit backend action (functions/src/domain/menus.ts's
//     publishMenu/archiveMenu) — never an arbitrary client PATCH of status.
//   - orderingOpensAt, orderingClosesAt, pickupStartsAt, pickupEndsAt:
//     timestamp (required) — the ordering and pickup windows. See
//     functions/src/domain/menus.ts's findScheduleViolation for the
//     relational rules these must satisfy.
//   - createdAt, updatedAt: timestamp (required)
//   - createdBy: string (required, immutable) — the Descope user ID that
//     created the menu.
//   - publishedAt: timestamp (optional) — set only once, when the menu is
//     published.
// Provisioned by trusted backend code only. Zesto is demand-driven, not
// inventory-driven: this document deliberately has no stock/inventory/
// remaining-quantity fields.
//
// Subcollection: organizations/{organizationId}/outlets/{outletId}/menus/{menuId}/items
// Document ID: {itemId} — a Firestore auto-ID.
// Fields:
//   - id: string (required, immutable) — must equal the document id.
//   - menuId: string (required, immutable) — must equal the parent menu id.
//     Unlike Menu (which duplicates organizationId/outletId), an item does
//     NOT duplicate organizationId/outletId/menuId's own ancestors — see
//     functions/src/domain/menuItems.ts.
//   - name: string (required, 1-100 chars). Not required to be unique
//     within a menu — variants (e.g. "Chicken Biriyani" vs "Chicken
//     Biriyani + Egg") are expected.
//   - description: string (optional, 0-500 chars)
//   - priceInPaise: number (required, non-negative integer) — money is
//     always integer paise, never a floating-point rupee amount (see root
//     CLAUDE.md). Changing an item's price never alters the price already
//     recorded on an existing order (Orders will snapshot their own price
//     at order time; not part of this implementation).
//   - enabled: boolean (required, defaults true) — whether customers may
//     currently order this item, independent of any inventory concept
//     (Zesto has none). Disabling is how an organization temporarily makes
//     a published menu's item unavailable without destroying it.
//   - displayOrder: number (required, non-negative integer)
//   - createdAt, updatedAt: timestamp (required)
//   - createdBy: string (required, immutable) — the Descope user ID that
//     created the item.
// Provisioned by trusted backend code only. A hard delete
// (functions/src/domain/menuItems.ts's deleteMenuItem) is only ever
// permitted while the parent menu is still 'draft' — a published or
// archived menu's item can only be disabled (enabled: false), never
// deleted, so historical menu/order data is never destroyed. Zesto is
// demand-driven, not inventory-driven: this document deliberately has no
// stock/inventory/remaining-quantity fields.
//
// Subcollection: organizations/{organizationId}/outlets/{outletId}/menus/{menuId}/orders
// Document ID: {orderId} — a Firestore auto-ID.
// Fields:
//   - id, userId, organizationId, outletId, menuId: string (required,
//     immutable) — id/organizationId/outletId/menuId must equal the path
//     this document is read from; userId is the customer who placed the
//     order, always derived server-side from the verified Descope session
//     (functions/src/auth/session.ts), never accepted from a client.
//   - status: string (required) — one of 'pending_payment' | 'confirmed' |
//     'cancelled'. A new order always starts 'pending_payment'; payment
//     integration (a later checkpoint) will transition it.
//   - paymentStatus: string (required) — 'pending' for v1; a new order
//     always starts here, payment integration transitions it later.
//   - currency: string (required) — 'INR' for v1.
//   - subtotalInPaise, totalInPaise: number (required, non-negative
//     integer) — totalInPaise equals subtotalInPaise for v1; there is no
//     tax/fee/discount system yet. Money is always integer paise, never a
//     floating-point rupee amount (see root CLAUDE.md).
//   - items: array (required, non-empty) of { itemId, name, priceInPaise,
//     quantity, lineTotalInPaise } — a point-in-time SNAPSHOT of the menu
//     items ordered, resolved from authoritative Firestore data at order
//     creation. Changing the source menu item's name, price, or enabled
//     state afterward never changes an existing order.
//   - createdAt, updatedAt: timestamp (required)
// Provisioned by trusted backend code only
// (functions/src/domain/orders.ts's createOrder), inside one Firestore
// transaction together with the idempotency record at
// users/{userId}/orderIdempotencyKeys/{idempotencyKey} above. Zesto is
// demand-driven, not inventory-driven: creating an order never writes to
// the menu or its items.
//
// Subcollection: organizations/{organizationId}/outlets/{outletId}/menus/{menuId}/orders/{orderId}/payments
// Document ID: {paymentId} — for v1 always equal to the parent order's own
// ID (see functions/src/domain/payments.ts's module doc comment): there is
// exactly one payment per order, ever. Fields:
//   - id, orderId, userId, organizationId, outletId, menuId: string
//     (required, immutable) — id/organizationId/outletId/menuId must equal
//     the path this document is read from; orderId must equal the parent
//     order's id; userId is the same customer who placed the order.
//   - amountInPaise: number (required, non-negative integer) — always
//     equal to the parent order's totalInPaise, never accepted from a
//     client (functions/src/domain/payments.ts's preparePayment).
//   - currency: string (required) — 'INR' for v1, always inherited from the
//     parent order.
//   - status: string (required) — one of 'pending' | 'succeeded' | 'failed'.
//     A new payment always starts 'pending'. Only trusted backend code
//     (functions/src/domain/payments.ts's markPaymentSucceeded/
//     markPaymentFailed) ever transitions it — there is no client-reachable
//     way to mark a payment (or its order) succeeded; see root CLAUDE.md's
//     "Never trust the frontend for security".
//   - provider: string (required) — 'none' for v1; no external payment
//     provider is connected yet.
//   - providerPaymentId: string (optional) — the provider's own reference,
//     once a real provider exists. Never fabricated; absent for every
//     payment v1 creates or transitions.
//   - createdAt, updatedAt: timestamp (required)
// Provisioned and transitioned by trusted backend code only. A successful
// transition (pending -> succeeded) happens atomically, in the same
// transaction, with the parent order's status becoming 'confirmed' and its
// paymentStatus becoming 'paid'.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Profile PII. Read/written via Cloud Functions only.
    match /users/{userId} {
      allow read, write: if false;

      // Order idempotency-key reservations. Backend-only, always.
      match /orderIdempotencyKeys/{idempotencyKey} {
        allow read, write: if false;
      }
    }

    // Tenant data. Read/written via Cloud Functions only.
    match /organizations/{organizationId} {
      allow read, write: if false;

      // Tenant-scoped membership and roles. Backend-only, always.
      match /members/{memberId} {
        allow read, write: if false;
      }

      // Outlets belonging to this organization. Backend-only, always.
      match /outlets/{outletId} {
        allow read, write: if false;

        // Menus belonging to this outlet. Backend-only, always.
        match /menus/{menuId} {
          allow read, write: if false;

          // Items belonging to this menu. Backend-only, always.
          match /items/{itemId} {
            allow read, write: if false;
          }

          // Customer orders belonging to this menu. Backend-only, always.
          match /orders/{orderId} {
            allow read, write: if false;

            // Payments belonging to this order. Backend-only, always — a
            // client must never be able to read a payment's status, let
            // alone write one (see root CLAUDE.md's core payment rule: the
            // browser must never be able to mark an order as paid).
            match /payments/{paymentId} {
              allow read, write: if false;
            }
          }
        }
      }

      // Per-organization outlet-slug uniqueness reservation. Backend-only,
      // always — same reasoning as organizationSlugs below, scoped one
      // level deeper.
      match /outletSlugs/{slug} {
        allow read, write: if false;
      }
    }

    // Slug uniqueness reservation for organization creation. Backend-only,
    // always — a client must never be able to reserve or discover a slug
    // outside the atomic transaction in
    // functions/src/domain/organizations.ts.
    match /organizationSlugs/{slug} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------
    // Deny everything else by default.
    // -----------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
