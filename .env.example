VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Descope (frontend). Add to your existing .env.local (gitignored):
#   VITE_DESCOPE_PROJECT_ID=<real development Descope Project ID>
# The backend needs the SAME Project ID as DESCOPE_PROJECT_ID in
# functions/.env.local (see functions/.env.example). Never put backend Descope
# settings or secrets (e.g. management keys) in VITE_* variables.
VITE_DESCOPE_PROJECT_ID=

# Public site (frontend). Real, confirmed business details for the public
# Contact/legal pages. Leave unset until confirmed; the site then shows a
# clearly marked placeholder instead of any invented value.
VITE_PUBLIC_SUPPORT_EMAIL=
VITE_PUBLIC_OPERATOR_NAME=
